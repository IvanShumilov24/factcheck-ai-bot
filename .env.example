BOT_TOKEN=
# При network_mode: host адреса указывают на сервисы и прокси на сервере.
TG_PROXY_URL=socks5://127.0.0.1:10808
# Если внешним API нужен другой прокси, укажите его здесь; пусто = TG_PROXY_URL.
EXTERNAL_PROXY_URL=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/factcheck
REDIS_URL=redis://127.0.0.1:6379/0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_INPUT_LENGTH=30000
MAX_TEXT_LENGTH=30000
MAX_URL_LENGTH=2048
MAX_DOWNLOAD_SIZE=5000000
REQUEST_TIMEOUT=10
MAX_REDIRECTS=3
MAX_IMAGE_SIZE=10000000
CONTENT_CACHE_TTL=3600
MOCK_OCR_TEXT=
CLAIM_CHUNK_SIZE=8000
CLAIM_CHUNK_OVERLAP=500
MAX_CLAIM_CHUNKS=20
CLAIM_PARALLELISM=2
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Пусто = Yandex Search работает напрямую, без прокси.
SEARCH_PROXY_URL=
YANDEX_SEARCH_TYPE=SEARCH_TYPE_RU
YANDEX_FAMILY_MODE=FAMILY_MODE_MODERATE
YANDEX_RESPONSE_FORMAT=FORMAT_XML
YANDEX_API_URL=https://searchapi.api.cloud.yandex.net/v2/web/search
SEARCH_CACHE_TTL=900
SEARCH_TIMEOUT=10
SEARCH_RESULTS_LIMIT=8
SEARCH_MAX_QUERIES_PER_CLAIM=5
SEARCH_RESULTS_PER_QUERY=8
SEARCH_MAX_UNIQUE_SOURCES=20
SEARCH_MAX_SOURCES_PER_DOMAIN=3
SEARCH_MAX_PASSES=2
SEARCH_EARLY_STOP_MIN_SOURCES=4
SEARCH_PARALLELISM=3
TOP_SOURCES_PER_CLAIM=5
SOURCE_FETCH_PARALLELISM=3
EVIDENCE_CHUNK_SIZE=6000
EVIDENCE_CHUNK_OVERLAP=400
MAX_EVIDENCE_CHUNKS=8
MAX_EVIDENCE_TEXT=24000
EVIDENCE_PARALLELISM=3
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60
QUEUE_STREAM=factcheck:jobs
QUEUE_GROUP=factcheck-workers
QUEUE_BLOCK_MS=5000
JOB_MAX_RETRIES=2
JOB_DEDUPE_TTL=3600
EXTERNAL_MAX_RETRIES=2
EXTERNAL_BACKOFF_SECONDS=0.5
